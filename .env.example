# 現調報告書の送り先。Vercel では「Environment Variables」に同じ名前で入れる。
#
# いまは稼働試験の段階。本番に切り替えるときは REPORT_MAIL_TO を
# 会社の受け取り用アドレスへ差し替える。

# 報告書が届くアドレス（稼働試験中は担当者本人あて）
REPORT_MAIL_TO=rahiseko@gmail.com

# 差出人。メール送信サービスで持ち主を確かめた独自ドメインである必要がある。
# 例: 現調報告書 <genchou@kouheikosehira.com>
REPORT_MAIL_FROM=

# メール送信サービス（Resend）の鍵
RESEND_API_KEY=
